# Copier en .env pour du developpement local avec des valeurs personnalisees.
# En conteneur, ces variables se passent normalement via l'environnement de
# la plateforme d'hebergement (pas de fichier .env commite -- §9 : secrets
# hors code).

# development | staging | production
HELIOS_ENV=development

# Origines autorisees en CORS, separees par des virgules.
HELIOS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Limite de requetes par defaut (syntaxe slowapi).
HELIOS_RATE_LIMIT=100/minute
