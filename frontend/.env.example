# Copier en .env.local pour du developpement avec des valeurs personnalisees.
# Laisser vide (comportement par defaut) tant que frontend et backend sont
# servis depuis la meme origine (proxy Vite en dev, nginx en conteneur) :
# l'app appelle alors "/api" en relatif.
#
# A renseigner uniquement si le backend est deploye sur un domaine different
# du frontend (ex. Vercel pour le frontend + Render pour le backend) :
# VITE_API_BASE_URL=https://helios-api.example.com
VITE_API_BASE_URL=
